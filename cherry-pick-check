#!/bin/bash

if [ "$#" -eq 0 ]; then
	start_commit='FETCH_HEAD'
else
	start_commit=$1
fi


if [ "$#" -eq 2 ]; then
	end_commit=$2
elif [ "$#" -le 1 ] && [ "$1" != '-h' ]; then
	end_commit="$start_commit"
else
	echo "Usage: $0 [<start-commit> [<end-commit>]]"
	exit 1
fi


# Function to check if a commit is a clean cherry-pick
check_cherry_pick() {
	local commit=$1

	# Extract the original commit hash from the commit message
	local original_commit=$(git log -1 --pretty=%B $commit | grep -oP '(?<=cherry picked from commit )\w+' | tail -n1)

	if [ -z "$original_commit" ]; then
		echo "Commit $commit does not contain 'cherry picked from commit <hash>' in its message."
		return 1
	fi

	local from_branch
	from_branch=$(git branch -a --contains $original_commit)
	if [ "$?" -ne 0 ]; then
		echo "Commit $commit points to a non-existing commit hash."
		return 1
	fi

	local printed_commit="$commit (on $(echo "$from_branch" | grep remotes | sed 's/  remotes\///') after $(git describe --abbrev=0 $original_commit))"

	# The lines of the range-diff that differ, stripped of the range-diff
	# indentation and of the "[<abc> fromtree] " title prefix
	local changes=$(git range-diff --no-color "$original_commit^..$original_commit" "$commit^..$commit" |
		grep -E '^    [-+][[:space:]]*[^[:space:]]' | sed -E 's/^    (.)    (\[(nrf|zep) fromtree\] )?/\1/')
	local title=$(git log -1 --pretty=%s $original_commit)
	local expected="-$title
+$title
+(cherry picked from commit $original_commit)"

	if [ "$changes" != "$expected" ]; then
		echo "Commit $printed_commit is NOT a clean cherry-pick of $original_commit."
		git range-diff "$original_commit^..$original_commit" "$commit^..$commit"
	else
		echo "$printed_commit OK"
	fi
}

# Iterate over each commit in the range
for commit in $(git rev-list --reverse $start_commit^..$end_commit); do
	check_cherry_pick $commit
done
